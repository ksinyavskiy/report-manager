{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GrafanaAgentOutput",
  "type": "object",
  "required": [
    "request_id",
    "agent",
    "status",
    "service",
    "time_range",
    "metric_intent",
    "selected_metrics",
    "metrics",
    "warnings",
    "error",
    "handoff"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "const": "grafana-agent"
    },
    "status": {
      "type": "string",
      "enum": ["success", "failed"]
    },
    "service": {
      "type": ["string", "null"]
    },
    "time_range": {
      "type": ["object", "null"],
      "required": ["from", "to"],
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "metric_intent": {
      "type": ["string", "null"],
      "enum": ["latency", "errors", "resource_usage", "general_health", null]
    },
    "selected_metrics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "unit", "points"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["timestamp", "value"],
              "properties": {
                "timestamp": {
                  "type": "string",
                  "format": "date-time"
                },
                "value": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "error": {
      "type": ["object", "null"],
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "handoff": {
      "type": ["object", "null"],
      "required": ["next_agent", "reason"],
      "properties": {
        "next_agent": {
          "const": "metric-analyzer-agent"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          },
          "handoff": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object"
          },
          "handoff": {
            "type": "null"
          }
        }
      }
    }
  ]
}
